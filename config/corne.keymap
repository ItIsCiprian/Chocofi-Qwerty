/*
 * Clean Chocofi QWERTY / 36-key inspired layout
 * Based on Peter X. Jang’s minimalist layout philosophy.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        label = "Chocofi QWERTY";

        default_layer {
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T           &kp Y     &kp U     &kp I     &kp O     &kp P
                &kp A     &kp S     &kp D     &kp F     &kp G           &kp H     &kp J     &kp K     &kp L     &kp SQT
                &kp Z     &kp X     &kp C     &kp V     &kp B           &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH
                              &kp ESC   &kp LALT  &kp LGUI  &kp SPACE      &kp ENTER &kp RAISE &kp LOWER &kp BACKSPACE
            >;
        };

        raise_layer {
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5          &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5          &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp F11   &kp F12   &kp MINUS &kp EQUAL &kp BSLH        &kp LBKT  &kp RBKT  &kp GRAVE &kp TILDE &none
                              &trans  &trans   &trans   &trans          &trans    &trans    &trans    &trans
            >;
        };

        lower_layer {
            bindings = <
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PERCENT     &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
                &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp UNDER       &kp HOME  &kp PG_DN &kp PG_UP &kp END   &none
                &kp K_PREVIOUS &kp K_PLAY_PAUSE &kp K_NEXT &kp C_VOLUME_DOWN &kp C_VOLUME_UP
                                 &kp MUTE  &bt BT_NXT &bt BT_CLR &bt BT_CLR_ALL &none
                              &trans &trans &trans &trans           &trans &trans &trans &trans
            >;
        };
    };
};
